{
  "name": "kleague-toto-predictor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "deploy": "npm run build:client && wrangler deploy",
    "build:client": "esbuild public/app.ts --bundle --outfile=public/app.js --format=iife --target=es2020",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p public/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply kleague-toto-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kleague-toto-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250718.0",
    "esbuild": "^0.23.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "wrangler": "^3.78.10"
  },
  "allowScripts": {
    "esbuild@0.23.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.17.19": true,
    "sharp@0.33.5": true,
    "workerd@1.20250718.0": true
  }
}
